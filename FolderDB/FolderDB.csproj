<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Not for shipping docs, but for the checks it turns on: unresolved cref, param name typos.
         1591 stays off: public types of the third level carry no xml documentation by design. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- VerifyReferenceTrimCompatibility and VerifyReferenceAotCompatibility stay off. They check
         whether a reference carries the IsTrimmable attribute, never whether its code is clean.
         Nito.AsyncEx predates the attribute and is AOT-clean throughout, verified by a NativeAOT
         publish with all of it rooted, so the flags only add a pair of warnings per Nito assembly. -->
  </PropertyGroup>

  <!-- No Version here on purpose: the release workflow takes it from the tag. -->
  <PropertyGroup>
    <Authors>Sumrix</Authors>
    <Copyright>Copyright © 2026 Sumrix</Copyright>
    <Description>A local-first file-system database for .NET. A folder is a table and a file is a record, so the data stays readable, editable and movable with ordinary operating system tools.</Description>
    <PackageTags>database;embedded;local-first;file-system;json;storage;repository</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/Sumrix/FolderDB</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Sumrix/FolderDB</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="Nito.AsyncEx.Coordination" Version="5.1.2" />
  </ItemGroup>

</Project>
